{
  "version": 1,
  "testCommand": "pnpm test",
  "coveragePaths": [".pre-cr/coverage.lcov"],
  "coverageFormat": "lcov",
  "threshold": 0,
  "coverageAdapters": [
    {
      "name": "no-instrumentation",
      "command": "node bin/precr-coverage.mjs",
      "coveragePath": ".pre-cr/coverage.lcov",
      "coverageFormat": "lcov"
    }
  ],
  "surfaces": {
    "covered": ["src/**", "src-tauri/**", "bin/**"],
    "ignored": [
      "node_modules/**",
      "dist/**",
      "src-tauri/target/**",
      "docs/**",
      "*.md",
      "*.json",
      "*.lock",
      "*.png",
      "*.ico",
      "*.icns"
    ],
    "unsupported": []
  },
  "checks": {
    "coverage": true,
    "security": false,
    "checklist": false
  }
}
