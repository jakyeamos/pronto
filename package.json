{
  "name": "pronto",
  "version": "1.0.0",
  "description": "A local-first portfolio command center for Git repositories.",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build:bundle": "tauri build --bundles app",
    "build:release": "tauri build",
    "app:update": "pnpm build:bundle && pnpm install:app",
    "build": "pnpm app:update",
    "app": "pnpm app:update",
    "app:check": "node scripts/install-app.mjs --check",
    "build:web": "vite build",
    "preview": "vite preview",
    "install:app": "node scripts/install-app.mjs",
    "papercuts:hook:install": "node scripts/install-papercuts-hook.mjs",
    "papercuts:hook:check": "node scripts/install-papercuts-hook.mjs --check",
    "papercuts:hook:test": "python3 scripts/test_papercuts_capture.py",
    "papercuts:cli:build": "env PATH=/opt/homebrew/bin:$PATH cargo build --manifest-path src-tauri/Cargo.toml --release --bin pronto_cli",
    "papercuts:cli:install": "node scripts/install-papercuts-cli.mjs",
    "papercuts:cli:check": "node scripts/install-papercuts-cli.mjs --check",
    "skills:collector:install": "node scripts/skill-usage-collector.mjs --install",
    "skills:collector:check": "node scripts/skill-usage-collector.mjs --check",
    "skills:collector:uninstall": "node scripts/skill-usage-collector.mjs --uninstall",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "audit:dead-code": "knip --no-progress --reporter compact",
    "audit:dependencies": "pnpm audit --audit-level high && cargo audit --file src-tauri/Cargo.lock",
    "audit:secrets": "env PATH=/opt/homebrew/bin:$PATH gitleaks git . --redact --no-banner",
    "format:check": "prettier --check .",
    "failure-visibility": "cargo test --manifest-path src-tauri/Cargo.toml skills::tests && vitest run src/renderer/src/components/SkillsComponents.test.tsx && node --test scripts/skill-usage-collector.test.mjs",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml && vitest run --passWithNoTests",
    "test:watch": "vitest",
    "smoke": "pnpm --silent run cli help && pnpm contract:check",
    "contract:check": "node --test scripts/validate-repository-contract.test.mjs scripts/build-workflow.test.mjs scripts/install-app.test.mjs scripts/cargo-routing.test.mjs scripts/skill-usage-collector.test.mjs scripts/showcase-materials.test.mjs scripts/install-papercuts-hook.test.mjs scripts/pronto-cli-entrypoint.test.mjs && node scripts/validate-repository-contract.mjs",
    "cli": "node bin/pronto.mjs",
    "cli:json": "node bin/pronto.mjs status --json"
  },
  "bin": {
    "pronto": "./bin/pronto.mjs"
  },
  "keywords": [
    "git",
    "desktop",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@xyflow/react": "^12.11.3",
    "elkjs": "^0.12.0",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "happy-dom": "^20.11.1",
    "knip": "^6.29.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
