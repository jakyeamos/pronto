{
  "name": "pronto",
  "version": "1.0.0",
  "description": "A local-first portfolio command center for Git repositories.",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build:bundle": "env PATH=/opt/homebrew/bin:$PATH tauri build",
    "build": "pnpm build:bundle && pnpm install:app",
    "app": "pnpm build",
    "app:check": "node scripts/install-app.mjs --check",
    "build:web": "vite build",
    "preview": "vite preview",
    "install:app": "node scripts/install-app.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "audit:dead-code": "knip --no-progress --reporter compact",
    "audit:dependencies": "pnpm audit --audit-level high && cargo audit --file src-tauri/Cargo.lock",
    "audit:secrets": "env PATH=/opt/homebrew/bin:$PATH gitleaks git . --redact --no-banner",
    "format:check": "prettier --check .",
    "test": "env PATH=/opt/homebrew/bin:$PATH cargo test --manifest-path src-tauri/Cargo.toml && vitest run --passWithNoTests",
    "test:watch": "vitest",
    "smoke": "pnpm --silent run cli help && pnpm contract:check",
    "contract:check": "node --test scripts/validate-repository-contract.test.mjs scripts/install-app.test.mjs && node scripts/validate-repository-contract.mjs",
    "cli": "node bin/pronto.mjs",
    "cli:json": "node bin/pronto.mjs status --json"
  },
  "bin": {
    "pronto": "./bin/pronto.mjs"
  },
  "keywords": [
    "git",
    "desktop",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "happy-dom": "^20.11.1",
    "knip": "^6.29.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
